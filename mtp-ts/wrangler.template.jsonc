{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mtp-demo",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "dist"
  },
  "routes": [
    {
      "pattern": "mtp.__BASE_DOMAIN__",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
