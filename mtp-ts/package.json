{
  "name": "mtp-ts",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun serve.ts",
    "test": "bun test",
    "build": "tsc --noEmit",
    "build:site": "rm -rf dist && mkdir -p dist/demo && bun build demo/app.ts --outdir dist/demo --target browser --minify && cp index.html dist/index.html",
    "deploy": "bun run build:site && wrangler deploy"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/bun": "^1.3.14",
    "wrangler": "^4.0.0"
  }
}
