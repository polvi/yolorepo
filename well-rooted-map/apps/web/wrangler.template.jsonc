{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "well-rooted-map",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/cog/*", "/api/*", "/llms.txt"]
  },
  "routes": [
    {
      "pattern": "well-rooted-map.__BASE_DOMAIN__",
      "custom_domain": true
    },
    // map.wellrootedproduce.co stays on external DNS (CNAME to
    // well-rooted-map.proc.io) and reaches us as a Cloudflare for SaaS custom
    // hostname on the proc.io zone; this route makes the worker answer it.
    // The app derives every URL from location.origin, so no code changes.
    {
      "pattern": "map.wellrootedproduce.co/*",
      "zone_name": "proc.io"
    }
  ],
  "vars": {
    "BASE_DOMAIN": "__BASE_DOMAIN__"
  },
  "r2_buckets": [
    {
      "binding": "COGS",
      "bucket_name": "well-rooted-map-cogs"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "well-rooted-map",
      "database_id": "__D1:well-rooted-map__"
    }
  ],
  "observability": {
    "enabled": true
  }
}
