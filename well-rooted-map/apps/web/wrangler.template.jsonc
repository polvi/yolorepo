{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "well-rooted-map",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/cog/*", "/llms.txt"]
  },
  "routes": [
    // Initial deployment. The map's eventual home is map.wellrootedproduce.co;
    // when that zone is on Cloudflare, add it here as a second custom_domain
    // route. The app derives every URL from location.origin, so no code moves.
    {
      "pattern": "well-rooted-map.__BASE_DOMAIN__",
      "custom_domain": true
    }
  ],
  "vars": {
    "BASE_DOMAIN": "__BASE_DOMAIN__"
  },
  "r2_buckets": [
    {
      "binding": "COGS",
      "bucket_name": "well-rooted-map-cogs"
    }
  ],
  "observability": {
    "enabled": true
  }
}
