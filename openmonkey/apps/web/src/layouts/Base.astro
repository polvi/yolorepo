---
interface Props {
  title: string;
  description?: string;
}
const { title, description = "Userscripts in the open. Publish, fork, and AI-scan before you run. Installs with any userscript manager." } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <style is:global>
      :root {
        --bg: #0d1117;
        --panel: #161b22;
        --border: #2d333b;
        --text: #e6edf3;
        --muted: #9198a1;
        --accent: #3fb950;
        --warn: #d29922;
        --fail: #f85149;
        --link: #58a6ff;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
        line-height: 1.6;
      }
      a { color: var(--link); text-decoration: none; }
      a:hover { text-decoration: underline; }
      .wrap { max-width: 960px; margin: 0 auto; padding: 0 1rem; }
      header.site {
        border-bottom: 1px solid var(--border);
        padding: 0.75rem 0;
      }
      header.site .wrap {
        display: flex; align-items: center; gap: 1.25rem; flex-wrap: wrap;
      }
      .logo { font-weight: 700; font-size: 1.1rem; color: var(--text); }
      .logo span { color: var(--accent); }
      nav { display: flex; gap: 1rem; flex-wrap: wrap; }
      main { padding: 2rem 0 4rem; }
      .card {
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 1rem 1.25rem;
        margin-bottom: 0.75rem;
      }
      .muted { color: var(--muted); font-size: 0.9rem; }
      .btn {
        display: inline-block;
        background: var(--accent);
        color: #04120a;
        font-weight: 600;
        padding: 0.5rem 1rem;
        border-radius: 6px;
        border: none;
        cursor: pointer;
      }
      .btn:hover { text-decoration: none; filter: brightness(1.1); }
      .btn.secondary { background: var(--panel); color: var(--text); border: 1px solid var(--border); }
      pre {
        background: #0a0d12;
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 1rem;
        overflow-x: auto;
        font-size: 0.85rem;
      }
      code { font-family: ui-monospace, "SF Mono", Menlo, monospace; }
      .badge {
        display: inline-block; padding: 0.1rem 0.55rem; border-radius: 999px;
        font-size: 0.75rem; font-weight: 600; border: 1px solid var(--border);
      }
      .badge.pass { color: var(--accent); border-color: var(--accent); }
      .badge.warn { color: var(--warn); border-color: var(--warn); }
      .badge.fail { color: var(--fail); border-color: var(--fail); }
      footer.site { border-top: 1px solid var(--border); padding: 1.5rem 0; }
      @media (max-width: 600px) {
        main { padding: 1.25rem 0 3rem; }
      }
    </style>
  </head>
  <body>
    <script>
      // Swap "Sign in" for "Account" when a proc.io session exists.
      fetch("https://authgravity.proc.io/v1/whoami", { credentials: "include" })
        .then((r) => {
          if (!r.ok) return;
          const a = document.getElementById("nav-auth") as HTMLAnchorElement | null;
          if (a) {
            a.textContent = "Account";
            a.href = "https://auth.proc.io/account";
          }
        })
        .catch(() => {});
    </script>
    <header class="site">
      <div class="wrap">
        <a class="logo" href="/">open<span>monkey</span></a>
        <nav>
          <a href="/scripts">Scripts</a>
          <a href="/publish">Publish</a>
          <a href="/install">Install</a>
          <a href="/docs">Docs</a>
          <a href="https://auth.proc.io/login?return_to=https://openmonkey.proc.io/scripts" id="nav-auth">Sign in</a>
        </nav>
      </div>
    </header>
    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>
    <footer class="site">
      <div class="wrap muted">
        openmonkey — userscripts in the open. Every script public, every verdict scanned by <em>your</em> model.
        <a href="/llms.txt">/llms.txt</a>
      </div>
    </footer>
  </body>
</html>
