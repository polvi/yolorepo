---
import Base from "../layouts/Base.astro";
---
<Base title="Publish — openmonkey" description="Publish a userscript to the open registry. Creation is publication.">
  <h1>Publish a script</h1>
  <p class="muted" style="max-width:42rem;">
    Publishing is public and immediate. The metadata block supplies the name and
    description unless you override them here; <code>@match</code> or
    <code>@include</code> is required. You need a
    <a href="https://auth.proc.io/login?return_to=https://openmonkey.proc.io/publish">proc.io session</a> to publish.
  </p>

  <form id="publish-form" style="display:flex; flex-direction:column; gap:0.75rem; max-width:42rem;">
    <input id="f-name" type="text" placeholder="Name (optional — taken from @name)"
      style="padding:0.5rem 0.75rem; background:var(--panel); border:1px solid var(--border); border-radius:6px; color:var(--text);" />
    <input id="f-desc" type="text" placeholder="Description (optional — taken from @description)"
      style="padding:0.5rem 0.75rem; background:var(--panel); border:1px solid var(--border); border-radius:6px; color:var(--text);" />
    <textarea id="f-code" rows="16" required spellcheck="false"
      placeholder={`// ==UserScript==\n// @name         My script\n// @description  What it does\n// @version      1.0.0\n// @match        https://example.com/*\n// ==/UserScript==\n(function () {\n  // …\n})();`}
      style="padding:0.75rem; background:#0a0d12; border:1px solid var(--border); border-radius:8px; color:var(--text); font-family:ui-monospace,Menlo,monospace; font-size:0.85rem; width:100%;"></textarea>
    <div style="display:flex; gap:0.75rem; flex-wrap:wrap;">
      <input id="f-slug" type="text" placeholder="Updating an existing script? Its slug (optional)"
        style="flex:1; min-width:16rem; padding:0.5rem 0.75rem; background:var(--panel); border:1px solid var(--border); border-radius:6px; color:var(--text);" />
      <input id="f-changelog" type="text" placeholder="Changelog (for updates)"
        style="flex:1; min-width:12rem; padding:0.5rem 0.75rem; background:var(--panel); border:1px solid var(--border); border-radius:6px; color:var(--text);" />
    </div>
    <p style="display:flex; gap:0.75rem; align-items:center; margin:0;">
      <button class="btn" type="submit">Publish publicly</button>
      <span id="f-status" class="muted"></span>
    </p>
  </form>

  <p class="muted" style="max-width:42rem; margin-top:1.5rem;">
    With a slug set, this publishes a new immutable version of that script
    (author only). The same flows exist as a JSON API — see
    <a href="/llms.txt">/llms.txt</a>.
  </p>

  <script>
    const form = document.getElementById("publish-form") as HTMLFormElement;
    const status = document.getElementById("f-status")!;
    const slugInput = document.getElementById("f-slug") as HTMLInputElement;
    const codeInput = document.getElementById("f-code") as HTMLTextAreaElement;

    // Editing flow: load an existing script's latest code into the form,
    // from ?slug=… (the script page's Edit button) or a typed slug.
    async function loadExisting(slug: string) {
      status.textContent = `loading ${slug}…`;
      try {
        const res = await fetch(
          `https://api.openmonkey.proc.io/api/scripts/${encodeURIComponent(slug)}`
        );
        if (!res.ok) {
          status.textContent = "No script with that slug.";
          return;
        }
        const { version } = await res.json();
        codeInput.value = version.code;
        status.textContent = `loaded v${version.version} — edit (or describe a change to your model), then publish`;
      } catch {
        status.textContent = "Network error loading the script.";
      }
    }
    const querySlug = new URLSearchParams(location.search).get("slug");
    if (querySlug) {
      slugInput.value = querySlug;
      loadExisting(querySlug);
    }
    slugInput.addEventListener("change", () => {
      const s = slugInput.value.trim();
      if (s && !codeInput.value.trim()) loadExisting(s);
    });
    const ERRORS: Record<string, string> = {
      invalid_code: "Code is missing or over 200 KB.",
      missing_name: "No name given and no @name in the metadata block.",
      missing_match_pattern: "A @match or @include line is required.",
      not_found: "No script with that slug.",
      forbidden: "Only the script's author can publish a new version.",
    };
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      status.textContent = "publishing…";
      const slug = (document.getElementById("f-slug") as HTMLInputElement).value.trim();
      const code = (document.getElementById("f-code") as HTMLTextAreaElement).value;
      const url = slug
        ? `https://api.openmonkey.proc.io/api/scripts/${encodeURIComponent(slug)}/versions`
        : "https://api.openmonkey.proc.io/api/scripts";
      const body = slug
        ? {
            code,
            changelog:
              (document.getElementById("f-changelog") as HTMLInputElement).value.trim() || undefined,
          }
        : {
            name: (document.getElementById("f-name") as HTMLInputElement).value.trim() || undefined,
            description: (document.getElementById("f-desc") as HTMLInputElement).value.trim() || undefined,
            code,
          };
      try {
        const res = await fetch(url, {
          method: "POST",
          credentials: "include",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(body),
        });
        if (res.status === 401) {
          status.innerHTML =
            'Sign in first: <a href="https://auth.proc.io/login?return_to=https://openmonkey.proc.io/publish">auth.proc.io</a>';
          return;
        }
        const data = await res.json();
        if (!res.ok) {
          if (data.error === "forbidden" && slug) {
            status.innerHTML =
              'Only the author can publish a new version — <a href="#" id="f-fork">fork it with your changes</a> instead.';
            document.getElementById("f-fork")!.addEventListener("click", async (ev) => {
              ev.preventDefault();
              status.textContent = "forking…";
              const fres = await fetch(
                `https://api.openmonkey.proc.io/api/scripts/${encodeURIComponent(slug)}/fork`,
                {
                  method: "POST",
                  credentials: "include",
                  headers: { "Content-Type": "application/json" },
                  body: JSON.stringify({ code }),
                }
              );
              const fdata = await fres.json();
              if (!fres.ok) {
                status.textContent = `Fork failed (${fdata.error ?? fres.status}).`;
                return;
              }
              location.href = `/scripts/${fdata.script.slug}`;
            });
            return;
          }
          status.textContent = ERRORS[data.error] ?? `Publish failed (${data.error ?? res.status}).`;
          return;
        }
        location.href = `/scripts/${slug || data.script.slug}`;
      } catch {
        status.textContent = "Network error — try again.";
      }
    });
  </script>
</Base>
