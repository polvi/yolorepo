---
import Base from "../../layouts/Base.astro";
import { apiFetch } from "../../lib/api";
const { slug } = Astro.params;
const data = await apiFetch(Astro.locals, `/scripts/${slug}`);
if (!data?.script) return new Response("Not found", { status: 404 });
const { script, version } = data;
const scansData = version ? await apiFetch(Astro.locals, `/versions/${version.id}/scans`) : null;
const scans = scansData?.scans ?? [];
const matches = version ? JSON.parse(version.match_patterns) : [];
---
<Base title={`${script.name} — openmonkey`} description={script.description ?? undefined}>
  <p><a href="/scripts">← all scripts</a></p>
  <h1 style="margin-bottom:0.25rem;">{script.name} {script.forked_from && <span class="badge">fork</span>}</h1>
  <p class="muted">
    by {script.author_handle ?? "anonymous"} · v{script.latest_version} ·
    {script.install_count} installs · published {script.created_at}
  </p>
  <p>{script.description}</p>
  <p style="display:flex; gap:0.75rem; flex-wrap:wrap; align-items:center;">
    <button class="btn" id="install-btn" data-slug={script.slug} data-version={script.latest_version}>
      Install with openmonkey
    </button>
    <a class="btn secondary" href={`https://api.openmonkey.proc.io/api/scripts/${script.slug}/raw`}>Raw .user.js</a>
    <span class="muted">Runs on: {matches.map((m: string) => <code style="margin-right:0.5rem;">{m}</code>)}</span>
  </p>

  <h2>Community scan verdicts</h2>
  {scans.length === 0 && <p class="muted">No published scans yet for v{version?.version}. Your install will produce the first one.</p>}
  {scans.map((r: any) => (
    <div class="card">
      <span class={`badge ${r.verdict}`}>{r.verdict}</span>
      <span class="muted"> by {r.reporter_handle ?? "anonymous"}{r.model ? ` · ${r.model}` : ""} · {r.created_at}</span>
      <div>{r.summary}</div>
    </div>
  ))}

  <h2>Source (v{version?.version})</h2>
  <pre><code>{version?.code}</code></pre>

  <script>
    // The extension's content script listens for this event on openmonkey.proc.io.
    document.getElementById("install-btn")?.addEventListener("click", (e) => {
      const btn = e.currentTarget as HTMLElement;
      window.postMessage(
        { type: "openmonkey:install", slug: btn.dataset.slug, version: Number(btn.dataset.version) },
        window.location.origin
      );
      btn.textContent = "Sent to extension…";
      setTimeout(() => {
        if (btn.textContent === "Sent to extension…") {
          btn.textContent = "Extension not detected — get it from /extension";
        }
      }, 1500);
      window.addEventListener("message", (ev) => {
        if (ev.data?.type === "openmonkey:install-ack") btn.textContent = "Scanning & installing…";
        if (ev.data?.type === "openmonkey:install-done") btn.textContent = "Installed ✓";
        if (ev.data?.type === "openmonkey:install-blocked") btn.textContent = "Blocked by scan ✗";
      });
    });
  </script>
</Base>
