---
import Base from "../../layouts/Base.astro";
import { apiFetch } from "../../lib/api";
const { slug } = Astro.params;
const data = await apiFetch(Astro, `/scripts/${slug}`);
if (!data?.script) return new Response("Not found", { status: 404 });
const { script, version } = data;
const scansData = version ? await apiFetch(Astro, `/versions/${version.id}/scans`) : null;
const scans = scansData?.scans ?? [];
const matches = version ? JSON.parse(version.match_patterns) : [];
---
<Base title={`${script.name} — openmonkey`} description={script.description ?? undefined}>
  <p><a href="/scripts">← all scripts</a></p>
  <h1 style="margin-bottom:0.25rem;">{script.name} {script.forked_from && <span class="badge">fork</span>}</h1>
  <p class="muted">
    by {script.author_handle ?? "anonymous"} · v{script.latest_version} ·
    {script.install_count} installs · published {script.created_at}
  </p>
  <p>{script.description}</p>
  <p style="display:flex; gap:0.75rem; flex-wrap:wrap; align-items:center;">
    <a class="btn" href={`/scripts/${script.slug}.user.js`}>Install {script.slug}.user.js</a>
    <a class="btn secondary" href={`/publish?slug=${script.slug}`}>Edit</a>
    <span class="muted">Runs on: {matches.map((m: string) => <code style="margin-right:0.5rem;">{m}</code>)}</span>
  </p>
  <p class="muted" style="max-width:42rem;">
    Opens in your userscript manager — <a href="/install">Userscripts for Safari, Tampermonkey, or
    Violentmonkey</a>. Check the scan verdicts below before you run code you didn't write.
  </p>

  <h2>Community scan verdicts</h2>
  {scans.length === 0 && <p class="muted">No published scans yet for v{version?.version}. Run one with your own model and publish the first verdict.</p>}
  {scans.map((r: any) => (
    <div class="card">
      <span class={`badge ${r.verdict}`}>{r.verdict}</span>
      <span class="muted"> by {r.reporter_handle ?? "anonymous"}{r.model ? ` · ${r.model}` : ""} · {r.created_at}</span>
      <div>{r.summary}</div>
    </div>
  ))}

  <h2>Source (v{version?.version})</h2>
  <pre><code>{version?.code}</code></pre>
</Base>
