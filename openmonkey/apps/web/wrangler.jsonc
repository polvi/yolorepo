{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openmonkey-web",
  "main": "dist/_worker.js/index.js",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "openmonkey.proc.io",
      "custom_domain": true
    }
  ],
  "services": [
    {
      "binding": "API",
      "service": "openmonkey-api"
    }
  ],
  "observability": {
    "enabled": true
  }
}
