---
import Base from "../layouts/Base.astro";
import { stackBase } from "../lib/stack";

const base = stackBase(Astro.url.hostname);
---
<Base title={`${base} auth — one sign-in for every project`}>
  <h1>One sign-in, every {base} project</h1>
  <p class="muted">
    This is the shared auth surface for {base} projects. Sign in once — with a
    passkey or a 12-word account key — and every <code>*.{base}</code> app sees
    the same session. No passwords, no email, nothing to leak.
  </p>
  <p>
    <a class="btn" href="/login">Sign in</a>
    <a class="btn secondary" href="/register" style="margin-left:0.5rem;">Create an account</a>
  </p>

  <h2>For project authors</h2>
  <div class="card">
    <p style="margin-top:0;">Send users here with a <code>return_to</code> back to your app
    (any <code>https</code> URL on <code>{base}</code> or a subdomain):</p>
    <p><code>https://auth.{base}/login?return_to=https://yourapp.{base}/…</code></p>
    <p style="margin-bottom:0;">Validate sessions by forwarding the <code>Cookie</code> header to
    <code>authgravity.{base}/v1/whoami</code>. Details in <a href="/llms.txt">/llms.txt</a>.</p>
  </div>
</Base>
