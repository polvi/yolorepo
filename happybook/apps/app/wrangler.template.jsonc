{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "happybook-app",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    {
      "pattern": "app.happybook.__BASE_DOMAIN__",
      "custom_domain": true
    }
  ],
  "vars": {
    "AUTH_ENDPOINT": "__AUTH_ENDPOINT__"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "happybook",
      "database_id": "__D1:happybook__"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BLOBS",
      "bucket_name": "happybook-blobs"
    }
  ],
  "observability": {
    "enabled": true
  }
}
