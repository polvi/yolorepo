{
  "name": "clusterpilot",
  "version": "0.1.0",
  "description": "Read-only Talos/Kubernetes upgrade planner that reasons with a local llama.cpp model",
  "type": "module",
  "private": true,
  "bin": {
    "clusterpilot": "./src/index.ts"
  },
  "scripts": {
    "clusterpilot": "bun run src/index.ts",
    "status": "bun run src/index.ts status",
    "plan": "bun run src/index.ts plan",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.84.2",
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "typebox": "^1.3.15",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
