{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tlc",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "workers_dev": false,
  "routes": [{ "pattern": "tlc.__BASE_DOMAIN__", "custom_domain": true }],
  "vars": { "AUTH_ENDPOINT": "__AUTH_ENDPOINT__" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tlc-hub",
      "database_id": "__D1:tlc__"
    }
  ],
  // The wasm checker lives in the tlc-engine worker (engine/), so a heavy
  // check runs in its own isolate with its own cpu_ms budget instead of
  // sharing this one with website traffic.
  "services": [{ "binding": "ENGINE", "service": "tlc-engine" }],
  "observability": { "enabled": true }
}
