---
import Base from "../../../../layouts/Base.astro";
import { apiFetch } from "../../../../lib/api";
import { relTime, fullDate, isTrackerKind } from "../../../../lib/meta";
import { renderMarkdown } from "../../../../lib/markdown";

const { owner, repo, number } = Astro.params;
const data = await apiFetch(Astro, `/repos/${owner}/${repo}/posts/${number}`);
if (!data) Astro.response.status = 404;

const post = data?.post;
const comments = data?.comments ?? [];
const title = post ? `${post.title} — ${owner}/${repo} — downstream` : "Not found — downstream";
---
<Base title={title}>
  {!data && (
    <section>
      <p class="eyebrow">404</p>
      <h1>No such post</h1>
      <p class="muted">
        Nothing at {owner}/{repo} #{number}.
        <a href={`/gh/${owner}/${repo}`}>Back to the project page</a>.
      </p>
    </section>
  )}
  {data && (
    <>
      <p class="eyebrow">
        <a href={`/gh/${owner}/${repo}`}>{owner}/{repo}</a> · #{post.number}
      </p>
      <h1>{post.title}</h1>
      <p class="post-meta">
        <span class={`kind ${post.kind}`}>{post.kind}</span>
        {isTrackerKind(post.kind) && post.status && (
          <span class={`status ${post.status}`}>{post.status}</span>
        )}
        <span class="who">
          <img class="avatar" src={post.author.avatar_url} alt="" loading="lazy" />
          {post.author.login}
        </span>
        <span class="muted small" title={post.created_at}>
          {fullDate(post.created_at)}
          {post.updated_at && post.updated_at !== post.created_at && (
            <> · updated {relTime(post.updated_at)}</>
          )}
        </span>
      </p>
      <article class="card md" set:html={renderMarkdown(post.body)} />

      <h2>Comments</h2>
      {comments.length === 0 && <p class="muted">No comments yet.</p>}
      {comments.map((c: any) => (
        <div class="card comment">
          <p class="comment-head">
            <span class="who">
              <img class="avatar" src={c.author.avatar_url} alt="" loading="lazy" />
              <strong>{c.author.login}</strong>
            </span>
            <span class="muted small" title={c.created_at}>{relTime(c.created_at)}</span>
          </p>
          <div class="md" set:html={renderMarkdown(c.body)} />
        </div>
      ))}
      <p class="muted small">
        To comment, connect your harness and use the <code>comment_post</code>{" "}
        tool. <a href="/docs">Docs</a>.
      </p>
    </>
  )}
</Base>

<style>
  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin: 0 0 1rem;
  }
  .comment-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin: 0 0 0.5rem;
  }
</style>
