{
  // The registrable domain every app in this repo hangs off of. Apps get
  // subdomains by convention: auth.<baseDomain>, openmonkey.<baseDomain>,
  // api.openmonkey.<baseDomain>, happybook.<baseDomain>,
  // app.happybook.<baseDomain>, tlc.<baseDomain>, mtp.<baseDomain>.
  //
  // Forks: do NOT edit this file. Copy stack.local.example.jsonc to
  // stack.local.jsonc (gitignored) and set your values there — it is
  // deep-merged over this one. See FORKING.md.
  "baseDomain": "proc.io",

  // AuthGravity deployment used for passkey sessions. null means
  // https://authgravity.<baseDomain>. Every app and this endpoint must share
  // the same registrable domain, or the shared session cookie breaks.
  "authEndpoint": null,

  // D1 database IDs per project (not secrets — just identifiers scoped to
  // the Cloudflare account that owns them). An empty or missing value makes
  // `bun run configure` omit database_id so wrangler provisions a fresh
  // database on first deploy.
  "d1": {
    "openmonkey": "43bbd871-ad28-43f1-b03f-184c7c85a5a4",
    "happybook": "370b871f-1a54-4150-92ab-f94206037216",
    "tlc": "554b8574-917e-41e9-878b-7fd1a5d5b5c8",
    "forkable": "4a314a3e-ce56-40f2-ae0b-052f413bca8d",
    "downstream": "4b6209cf-c11d-48da-bfce-a1a87664a408",
    "tabby": "53de4dbc-b74e-4d1e-8fdb-5a39fe6eaf44",
    "molemap": "4120d4c7-c088-4a51-9421-ea116349a493",
    "backtalk": "53c11269-b0dd-47d7-b67a-c5242a392d0f",
    "well-rooted-map": "c71433f2-e0b1-4e8c-ba32-a4e73e1e11be",
    "gpubnb": "709885b3-1f02-450c-8e2b-63f805bc9e8e"
  }
}
